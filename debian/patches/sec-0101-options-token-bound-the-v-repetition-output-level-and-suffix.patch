From 14402f77f6bed4e31ff6c24fb2dae0ada723a2d4 Mon Sep 17 00:00:00 2001
From: t <t@t>
Date: Mon, 21 Sep 2026 12:13:10 +0800
Subject: [PATCH 101/200] 8190f471

---
 options.c | 10 ++++++++--
 token.c   |  7 +++++++
 2 files changed, 15 insertions(+), 2 deletions(-)

diff --git a/options.c b/options.c
index 8cd3e112..74618910 100644
--- a/options.c
+++ b/options.c
@@ -452,7 +452,10 @@ static void parse_output_words(struct output_struct *words, short *levels, const
 				len--;
 		}
 		lev = isDigit(str+len) ? atoi(str+len) : 1;
-		if (lev > MAX_OUT_LEVEL)
+		/* atoi() of an overflowing positive digit string can return a
+		 * negative int (LONG_MAX truncated on LP64); a negative lev
+		 * here later indexes counts[lev] in make_output_option(). */
+		if (lev > MAX_OUT_LEVEL || lev < 0)
 			lev = MAX_OUT_LEVEL;
 		if (len == 4 && strncasecmp(str, "help", 4) == 0) {
 			output_item_help(words);
@@ -2673,7 +2676,10 @@ void server_options(char **args, int *argc_p)
 	if (protect_args)
 		argstr[x++] = 's';
 
-	for (i = 0; i < verbose; i++)
+	/* `verbose` is unbounded (one increment per -v on our own command
+	 * line), so an uncapped loop walks past argstr[64].  Anything beyond
+	 * level ~5 is meaningless to the server anyway. */
+	for (i = 0; i < verbose && i < 9; i++)
 		argstr[x++] = 'v';
 
 	if (quiet && msgs2stderr)
diff --git a/token.c b/token.c
index b527c7d7..b47a7852 100644
--- a/token.c
+++ b/token.c
@@ -163,6 +163,13 @@ static void add_nocompress_suffixes(const char *str)
 		} while (*++f != '/' && *f);
 		*t++ = '\0';
 
+		/* add_suffix() recurses once per character; an attacker-supplied
+		 * --skip-compress (from our own argv OR propagated to a daemon
+		 * receiver via server_options()) with one very long token
+		 * exhausts the stack.  Real file extensions are short -- cap
+		 * the recursion depth by truncating absurd suffixes. */
+		if (t - buf > 32 + 1)
+			buf[32] = '\0';
 		add_suffix(&suftree, *buf, buf+1);
 	}
 
