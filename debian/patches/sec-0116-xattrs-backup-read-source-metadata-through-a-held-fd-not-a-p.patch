+			if (!backup_metadata_hardened() || bfd >= 0) {
+# ifdef SUPPORT_ACLS
+				if (preserve_acls && !S_ISLNK(file->mode)) {
+					get_acl_fdat(bfd, -1, NULL, rel, &sx);
+					cache_tmp_acl(file, &sx);
+					free_acl(&sx);
+				}
+# endif
+# ifdef SUPPORT_XATTRS
+				if (preserve_xattrs) {
+					get_xattr(rel, bfd, &sx);
+					cache_tmp_xattr(file, &sx);
+					free_xattr(&sx);
+				}
+# endif
