-				get_xattr(rel, &sx);
-				cache_tmp_xattr(file, &sx);
-				free_xattr(&sx);
+			if (bfd >= 0)
+				close(bfd);
 			}
 #endif
 			set_file_attrs(backup_dir_buf, file, NULL, NULL, 0);
@@ -260,18 +295,27 @@ static int make_backup_inner(const char *fname, BOOL prefer_rename)
