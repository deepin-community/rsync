From b89f4b00419160c313f289285635bba78e06ff89 Mon Sep 17 00:00:00 2001
From: t <t@t>
Date: Mon, 21 Sep 2026 12:13:13 +0800
Subject: [PATCH 162/200] 0875194e

---
 support/rrsync | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/support/rrsync b/support/rrsync
index a5618b73..4c571f0f 100755
--- a/support/rrsync
+++ b/support/rrsync
@@ -357,6 +357,11 @@ def validated_arg(opt, arg, typ=3, wild=False):
     if opt != 'arg': # arg values already have their backslashes removed.
         arg = DE_BACKSLASH_RE.sub(r'\1', arg)
 
+    # "-" is rsync's read-the-list-from-stdin sentinel, not a pathname: a pull
+    # with a local --files-from sends exactly "--files-from=-" to the server.
+    if opt == '--files-from' and arg == '-':
+        return arg
+
     orig_arg = arg
     if arg.startswith('./'):
         arg = arg[1:]
