+						who_am_i(), thisname, xflags);
+				}
+				xflags |= XMIT_NO_CONTENT_DIR | XMIT_TOP_DIR;
+			}
 			if (!(xflags & XMIT_NO_CONTENT_DIR)) {
 				if (xflags & XMIT_TOP_DIR)
 					file->flags |= FLAG_TOP_DIR;
