diff --git a/util1.c b/util1.c
index fdd5f0cb..0ae7a2d1 100644
--- a/util1.c
+++ b/util1.c
@@ -668,6 +668,13 @@ int copy_file(const char *source, const char *dest, int tmpfilefd, mode_t mode)
 		return -1;
 	}
 
+#ifdef SUPPORT_XATTRS
+	/* Set xattrs through ofd while it's still held so a parent-symlink race
